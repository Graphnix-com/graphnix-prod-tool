# Copy to .env and fill in. Never commit .env.
# On the server: /srv/graphnix/<env>/.env, chmod 600.
# Comments must be on their own line: values are read literally.

# --- App ---------------------------------------------------------------------
# local | staging | production
APP_ENV=local
# false on staging and production
DEBUG=true
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# e.g. jobs.graphnix.com (comma-separated)
ALLOWED_HOSTS=localhost
# e.g. https://jobs.graphnix.com
CSRF_TRUSTED_ORIGINS=
# Raise to 31536000 once HTTPS is proven in production
SECURE_HSTS_SECONDS=0

# --- Database ----------------------------------------------------------------
# Local dev (compose.dev.yaml): postgres://graphnix:graphnix@127.0.0.1:5432/graphnix?connect_timeout=5
# (127.0.0.1, not localhost: on Windows, localhost tries IPv6 first and hangs.)
# Servers: postgres://graphnix:<POSTGRES_PASSWORD>@db:5432/graphnix
DATABASE_URL=postgres://graphnix:graphnix@127.0.0.1:5432/graphnix?connect_timeout=5
# Servers only: the password the db container is created with
POSTGRES_PASSWORD=graphnix

# --- Microsoft 365 (Graph) ---------------------------------------------------
# Leave blank locally: emails print to the console instead of being sent.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# tracker-test@graphnix.com everywhere except production (info@graphnix.com)
M365_SENDER=tracker-test@graphnix.com

# --- Microsoft 365 sign-in (docs/sign-in-setup.md) ---------------------------
# Object IDs of the Entra security groups that give each tracker role. Not secret.
# The Microsoft button appears once the three values above and the Admin or Manager
# group are set; until then, sign in with a password.
M365_GROUP_ADMIN=
M365_GROUP_MANAGER=
M365_GROUP_PRODUCTION=

# --- Square (Step 2), read-only ----------------------------------------------
# Square stays off until the token and signature key are set. Sandbox on staging,
# production on jobs.graphnix.com. Secrets: this file only, never in Git.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Exactly as entered in Square's webhook subscription:
SQUARE_WEBHOOK_URL=https://staging.jobs.graphnix.com/integrations/square/webhook/
SQUARE_LOCATION_ID=
# Order sources that are online stores (their orders become jobs), comma-separated:
SQUARE_STORE_SOURCES=Square Online
# Square estimates are read from Square's emails in this mailbox (blank: off):
ESTIMATE_MAILBOX=
# The website's contact form emails become requests. Blank: the same mailbox as the
# estimates; "off" turns it off.
WEBFORM_MAILBOX=

# --- Crash emails (NFR-08) ---------------------------------------------------
CRASH_EMAIL_TO=josh@graphnix.com

# --- Servers only ------------------------------------------------------------
# graphnix-staging | graphnix-production
COMPOSE_PROJECT_NAME=graphnix-local
BACKUP_STATE_HOST_DIR=/srv/graphnix/backups/state
