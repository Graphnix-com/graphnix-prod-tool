# Copy to .env and fill in. Never commit .env.
# On the server: /srv/graphnix/<env>/.env, chmod 600.
# Comments must be on their own line: values are read literally.

# --- App ---------------------------------------------------------------------
# local | staging | production
APP_ENV=local
# false on staging and production
DEBUG=true
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# e.g. jobs.graphnix.com (comma-separated)
ALLOWED_HOSTS=localhost
# e.g. https://jobs.graphnix.com
CSRF_TRUSTED_ORIGINS=
# Raise to 31536000 once HTTPS is proven in production
SECURE_HSTS_SECONDS=0

# --- Database ----------------------------------------------------------------
# Local dev (compose.dev.yaml): postgres://graphnix:graphnix@localhost:5432/graphnix
# Servers: postgres://graphnix:<POSTGRES_PASSWORD>@db:5432/graphnix
DATABASE_URL=postgres://graphnix:graphnix@localhost:5432/graphnix
# Servers only: the password the db container is created with
POSTGRES_PASSWORD=graphnix

# --- Microsoft 365 (Graph) ---------------------------------------------------
# Leave blank locally: emails print to the console instead of being sent.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# tracker-test@graphnix.com everywhere except production (info@graphnix.com)
M365_SENDER=tracker-test@graphnix.com

# --- Crash emails (NFR-08) ---------------------------------------------------
CRASH_EMAIL_TO=josh@graphnix.com

# --- Servers only ------------------------------------------------------------
# graphnix-staging | graphnix-production
COMPOSE_PROJECT_NAME=graphnix-local
BACKUP_STATE_HOST_DIR=/srv/graphnix/backups/state
